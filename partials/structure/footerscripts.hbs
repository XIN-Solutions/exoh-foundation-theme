{{let . site=(ancestor-of-type 'site')}}
{{let . content=site.content}}
{{let . siteSettings=content.forms.site}}

<script id="bootstrap-js" src="{{theme.url}}/assets/js/bootstrap.min.js"></script>


<link rel="stylesheet" href="{{theme.url}}/assets/js/aos.css">
<link rel="stylesheet" href="{{theme.url}}/assets/css/message-bar.css">
<noscript>
    <style type="text/css">
        [data-aos] {
            opacity: 1 !important;
            transform: translate(0) scale(1) !important;
        }
    </style>
</noscript>

<script src="{{theme.url}}/assets/js/htmx.min.js"></script>
<script src="{{theme.url}}/assets/js/aos.js"></script>
<script src="{{theme.url}}/assets/js/theme.js"></script>
<script src="{{theme.url}}/assets/js/message-bar.js"></script>
<script src="{{theme.url}}/assets/libs/swiper/swiper-bundle.min.js"></script>
<script src="https://cdn.jsdelivr.net/npm/glightbox/dist/js/glightbox.min.js"></script>
<script src="{{theme.url}}/assets/js/behaviour.js"></script>

{{{siteSettings.bodyScripts}}}


<script>

    (function () {
        var rootStyles = getComputedStyle(document.documentElement);
        var duration = parseInt(rootStyles.getPropertyValue('--theme-aos-duration'), 10);
        var stagger = parseInt(rootStyles.getPropertyValue('--theme-aos-stagger'), 10);
        if (!isFinite(duration)) {
            duration = 1000;
        }
        if (!isFinite(stagger)) {
            stagger = 100;
        }
        document.querySelectorAll('[data-aos-order]').forEach(function (el) {
            var order = parseInt(el.getAttribute('data-aos-order'), 10);
            if (!isFinite(order)) {
                order = 0;
            }
            el.setAttribute('data-aos-duration', String(duration));
            el.setAttribute('data-aos-delay', String(order * stagger));
        });
    })();

    AOS.init({
        once: true
    });

    if (typeof GLightbox !== 'undefined') {
        GLightbox({
            selector: '.glightbox'
        });
    }

</script>
