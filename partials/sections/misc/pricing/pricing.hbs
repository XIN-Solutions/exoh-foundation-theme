{{let . resolvedPlans=(?? plans config.plans)}}
{{let . resolvedTrustedBy=(?? trustedBy config.trustedBy)}}

<section
    class="
        pricing-1
        {{#if config.useAltBackground}}
            bg-alternate bg--alternate
        {{else}}
            primaryColor-bg altBackgroundColor-text
        {{/if}}
        spacing--{{?? config.spacing 'comfortable'}}
        {{?: config.noTopSpacing 'spacing--no-top' ''}}
        {{?: config.noBottomSpacing 'spacing--no-bottom' ''}}
    "
    no-edit="children"
    allowadd="no"
    allowdelete="no"
>
    <div class="container">
        {{#unless config.hideHeader}}
            <div class="row justify-content-center mb-5">
                <div class="col-lg-8 text-center">
                    {{#unless config.hidePretitle}}
                        <p class="text-uppercase small fw-semibold mb-2 tertiaryColor-text" edit="pretitle innerHTML">
                            {{{?? pretitle "Plans"}}}
                        </p>
                    {{/unless}}
                    <h2 class="mb-3 h2-all" edit="title innerHTML">
                        {{{?? title "Simple, transparent pricing"}}}
                    </h2>
                    {{#unless config.hideDescription}}
                        <p class="lead mb-0 h3-all" edit="description innerHTML">
                            {{{?? description "Choose the plan that fits your team. Upgrade or downgrade at any time."}}}
                        </p>
                    {{/unless}}
                </div>
            </div>
        {{/unless}}

        <div class="row justify-content-center g-4">
            {{#each resolvedPlans}}
                <div class="col-12 col-md-6 col-lg-4">
                    <div class="card h-100 shadow-sm pricing-plan-card {{?: highlighted 'pricing-plan-card--highlighted border border-2' ''}}">
                        {{#unless ../config.hideBadge}}
                            {{#if badge}}
                                <div class="pricing-plan-badge tertiaryColor-bg altBackgroundColor-text text-uppercase small fw-bold">
                                    {{badge}}
                                </div>
                            {{/if}}
                        {{/unless}}

                        <div class="card-body d-flex flex-column p-4">
                            <div class="mb-4">
                                <h3 class="h4 mb-1 {{?: highlighted 'tertiaryColor-text' ''}}">
                                    {{?? name "Plan"}}
                                </h3>
                                <p class="small text-muted mb-0">{{?? subtitle "Plan subtitle"}}</p>
                            </div>

                            <div class="mb-4 d-flex align-items-baseline gap-1">
                                <span class="display-5 fw-bold mb-0">{{?? price "$99"}}</span>
                                {{#unless ../config.hidePriceSuffix}}
                                    {{#if priceSuffix}}
                                        <span class="small text-uppercase text-muted fw-semibold">{{priceSuffix}}</span>
                                    {{/if}}
                                {{/unless}}
                            </div>

                            <ul class="list-unstyled flex-grow-1 mb-4">
                                {{#each (?? features benefits)}}
                                    <li class="d-flex align-items-start gap-2 mb-3 {{?: included '' 'text-muted'}}">
                                        <i no-edit class="la {{?: included 'la-check tertiaryColor-text' 'la-times'}} mt-1" aria-hidden="true"></i>
                                        <span class="small">{{?? label "Feature"}}</span>
                                    </li>
                                {{/each}}
                            </ul>

                            <a
                                class="btn w-100 {{?: highlighted 'buttonColor-bg altBackgroundColor-text' 'btn-outline-primary'}}"
                                href="{{?? ctaUrl '#'}}"
                            >
                                {{?? ctaLabel "Choose plan"}}
                            </a>
                        </div>
                    </div>
                </div>
            {{/each}}
        </div>

        {{#unless config.hideTrustedBy}}
            <div class="text-center mt-5" no-edit>
                {{#unless config.hideTrustedByLabel}}
                    <p class="small text-uppercase text-muted fw-semibold mb-3" edit="trustedByLabel innerHTML">
                        {{{?? trustedByLabel "Trusted by teams at"}}}
                    </p>
                {{/unless}}
                <div class="d-flex flex-wrap justify-content-center align-items-center gap-4 pricing-trusted-by" no-edit>
                    {{#each resolvedTrustedBy}}
                        <a class="text-decoration-none fw-bold opacity-50" href="{{?? url '#'}}">
                            {{?? name "BRAND"}}
                        </a>
                    {{/each}}
                </div>
            </div>
        {{/unless}}

        {{#if config.currency}}
            <p class="text-center small text-muted mt-4 mb-0">Prices are in {{config.currency}}</p>
        {{/if}}
    </div>
</section>
