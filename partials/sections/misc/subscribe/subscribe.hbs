<section
    class="
        subscribe-1
        {{?: config.useAltBackground 'bg--alternate' ''}}
        spacing--{{?? config.spacing 'comfortable'}}
        {{?: config.noTopSpacing 'spacing--no-top' ''}}
        {{?: config.noBottomSpacing 'spacing--no-bottom' ''}}
    "
    no-edit="children"
    allowadd="no"
    allowdelete="no"
>
    <div class="container">
        <div class="row justify-content-center">
            <div class="col-md-{{?? config.columnSize '8'}} col-sm-12">
                <div class="subscribe-card position-relative overflow-hidden p-4 p-lg-5">
                    {{#unless config.hidePattern}}
                        <div class="subscribe-pattern" aria-hidden="true">
                            <svg fill="none" viewBox="0 0 400 400" xmlns="http://www.w3.org/2000/svg">
                                <circle cx="200" cy="200" r="199" stroke="currentColor" stroke-width="0.5"></circle>
                                <circle cx="200" cy="200" r="150" stroke="currentColor" stroke-width="0.5"></circle>
                                <circle cx="200" cy="200" r="100" stroke="currentColor" stroke-width="0.5"></circle>
                            </svg>
                        </div>
                    {{/unless}}

                    <div class="subscribe-content position-relative">
                        <h2 class="mb-3 h2-all" edit="title innerHTML">
                            {{{?? title "Stay in the loop"}}}
                        </h2>

                        {{#unless config.hideDescription}}
                            <p class="lead mb-4 h3-all" edit="description innerHTML">
                                {{{?? description "Monthly product updates and release notes. No spam."}}}
                            </p>
                        {{/unless}}

                        {{#unless config.hideForm}}
                            <form
                                class="subscribe-form"
                                action="{{?? formAction '#'}}"
                                method="post"
                            >
                                <div class="row g-3 align-items-end">
                                    {{#unless config.hideEmailInput}}
                                        <div class="col-12 col-md">
                                            <label class="form-label small fw-semibold mb-1" for="subscribe-email">
                                                {{?? config.emailLabel "Email address"}}
                                            </label>
                                            <input
                                                id="subscribe-email"
                                                class="form-control"
                                                type="email"
                                                name="email"
                                                placeholder="{{?? config.emailPlaceholder 'you@company.com'}}"
                                                autocomplete="email"
                                                required
                                            >
                                        </div>
                                    {{/unless}}

                                    {{#unless config.hideButton}}
                                        <div class="col-12 col-md-auto">
                                            <button
                                                class="btn buttonColor-bg altBackgroundColor-text w-100 w-md-auto px-4"
                                                type="submit"
                                                edit="buttonLabel innerHTML"
                                            >
                                                {{{?? buttonLabel "Subscribe"}}}
                                            </button>
                                        </div>
                                    {{/unless}}
                                </div>
                            </form>
                        {{/unless}}

                        {{#unless config.hidePrivacyNote}}
                            <p class="small text-muted mt-3 mb-0">
                                {{{?? config.privacyNote "We respect your privacy. Unsubscribe at any time."}}}
                            </p>
                        {{/unless}}
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>
