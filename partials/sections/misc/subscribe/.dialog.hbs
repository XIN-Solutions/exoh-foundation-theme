<form class="config-form"
      x-data="componentDialog({
            defaultConfig: {
                emailPlaceholder: 'you@company.com',
                emailLabel: 'Email address',
                privacyNote: 'We respect your privacy. Unsubscribe at any time.',
                columnSize: '8',
                hidePattern: false,
                hideDescription: false,
                hideForm: false,
                hideEmailInput: false,
                hideButton: false,
                hidePrivacyNote: false,
                useAltBackground: false,
                spacing: 'comfortable',
                noTopSpacing: false,
                noBottomSpacing: false
            }
      })"
      @set="setConfig"
      @get="getConfig"
>
    <ul class="nav nav-tabs" role="tablist">
        <li class="nav-item"><a class="nav-link active" data-bs-toggle="tab" href="#subscribe-component" role="tab">Component</a></li>
        <li class="nav-item"><a class="nav-link" data-bs-toggle="tab" href="#subscribe-layout" role="tab">Layout</a></li>
        <li class="nav-item"><a class="nav-link" data-bs-toggle="tab" href="#subscribe-show-hide" role="tab">Show/Hide</a></li>
        {{> common/dialogs/basic_nav }}
    </ul>

    <div class="tab-content">
        <div class="tab-pane show active" id="subscribe-component" role="tabpanel">
            <div class="p-3 bg-light border rounded mt-3">
                <div class="mb-3">
                    <label class="form-label small text-muted mb-1">Email field label</label>
                    <input class="form-control" type="text" x-model="config.emailLabel" placeholder="Email address">
                </div>
                <div class="mb-3">
                    <label class="form-label small text-muted mb-1">Email placeholder</label>
                    <input class="form-control" type="text" x-model="config.emailPlaceholder" placeholder="you@company.com">
                </div>
                <div class="mb-0">
                    <label class="form-label small text-muted mb-1">Privacy note</label>
                    <textarea class="form-control" rows="2" x-model="config.privacyNote" placeholder="We respect your privacy. Unsubscribe at any time."></textarea>
                </div>
            </div>
        </div>

        <div class="tab-pane" id="subscribe-layout" role="tabpanel">
            <div class="p-3 bg-light border rounded mt-3">
                <label class="form-label" for="subscribeColumnSize">Content width</label>
                <select class="form-select" id="subscribeColumnSize" x-model="config.columnSize">
                    <option value="6">Narrow (6 columns)</option>
                    <option value="8">Medium (8 columns)</option>
                    <option value="10">Wide (10 columns)</option>
                    <option value="12">Full width (12 columns)</option>
                </select>
                <p class="form-text text-muted mb-0 small">Controls how wide the subscribe card appears within the page container.</p>
            </div>
        </div>

        <div class="tab-pane" id="subscribe-show-hide" role="tabpanel">
            <div class="p-3 bg-light border rounded mt-3">
                <div class="mb-3"><div class="form-check"><input class="form-check-input" type="checkbox" x-model="config.hidePattern" id="subscribeHidePattern"><label class="form-check-label" for="subscribeHidePattern">Hide background pattern</label></div></div>
                <div class="mb-3"><div class="form-check"><input class="form-check-input" type="checkbox" x-model="config.hideDescription" id="subscribeHideDescription"><label class="form-check-label" for="subscribeHideDescription">Hide description</label></div></div>
                <div class="mb-3"><div class="form-check"><input class="form-check-input" type="checkbox" x-model="config.hideForm" id="subscribeHideForm"><label class="form-check-label" for="subscribeHideForm">Hide form</label></div></div>
                <div class="mb-3"><div class="form-check"><input class="form-check-input" type="checkbox" x-model="config.hideEmailInput" id="subscribeHideEmailInput"><label class="form-check-label" for="subscribeHideEmailInput">Hide email input</label></div></div>
                <div class="mb-3"><div class="form-check"><input class="form-check-input" type="checkbox" x-model="config.hideButton" id="subscribeHideButton"><label class="form-check-label" for="subscribeHideButton">Hide submit button</label></div></div>
                <div class="mb-0"><div class="form-check"><input class="form-check-input" type="checkbox" x-model="config.hidePrivacyNote" id="subscribeHidePrivacyNote"><label class="form-check-label" for="subscribeHidePrivacyNote">Hide privacy note</label></div></div>
            </div>
        </div>

        {{> common/dialogs/basic_content hideAlternateBackground=false }}
    </div>
</form>
