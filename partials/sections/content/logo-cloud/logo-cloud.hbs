{{let . resolvedLogos=(?? logos config.logos)}}

<section
    class="
        logo-cloud
        {{?: config.useAltBackground 'bg--alternate' ''}}
        spacing--{{?? config.spacing 'comfortable'}}
        {{?: config.noTopSpacing 'spacing--no-top' ''}}
        {{?: config.noBottomSpacing 'spacing--no-bottom' ''}}
    "
    no-edit="children"
    allowadd="no"
    allowdelete="no"
>
    <div class="container">
        {{#unless config.hideTitle}}
            <div class="row justify-content-center mb-4">
                <div class="col-lg-8 {{?: config.centerTitle 'text-center' 'text-start'}}">
                    <h2 class="mb-0 h2-all" edit="title innerHTML">
                        {{{?? title "Trusted by industry leaders"}}}
                    </h2>
                </div>
            </div>
        {{/unless}}

        <div class="row justify-content-center">
            <div class="col-12">
                {{#if resolvedLogos.length}}
                    <div
                        class="logo-cloud__grid d-flex flex-wrap justify-content-center align-items-center {{?: config.grayscale 'logo-cloud--grayscale' ''}}"
                        no-edit
                    >
                        {{#each resolvedLogos}}
                            {{#if url}}
                                <a
                                    href="{{url}}"
                                    class="logo-cloud__item text-decoration-none"
                                    aria-label="{{?? alt 'Partner logo'}}"
                                >
                                    <img
                                        src="{{?? imageUrl '/assets/img/empty.png'}}"
                                        alt="{{?? alt ''}}"
                                        loading="lazy"
                                        class="img-fluid logo-cloud__image"
                                    >
                                </a>
                            {{else}}
                                <div class="logo-cloud__item">
                                    <img
                                        src="{{?? imageUrl '/assets/img/empty.png'}}"
                                        alt="{{?? alt ''}}"
                                        loading="lazy"
                                        class="img-fluid logo-cloud__image"
                                    >
                                </div>
                            {{/if}}
                        {{/each}}
                    </div>
                {{else}}
                    <div class="alert alert-warning mb-0" role="alert">
                        No logos configured yet.
                    </div>
                {{/if}}
            </div>
        </div>
    </div>
</section>
