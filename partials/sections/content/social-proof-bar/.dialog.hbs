<form class="config-form"
      x-data="(() => {
            const base = componentDialog({
                defaultConfig: {
                    rating: 4.8,
                    maxRating: 5,
                    centerContent: true,
                    hideRating: false,
                    hideReviewCount: false,
                    hideBadges: false,
                    useAltBackground: false,
                    spacing: 'comfortable',
                    noTopSpacing: false,
                    noBottomSpacing: false,
                    badges: [
                        {
                            platform: 'g2',
                            label: 'G2',
                            enabled: true,
                            imageUrl: '/assets/img/empty.png',
                            url: ''
                        },
                        {
                            platform: 'capterra',
                            label: 'Capterra',
                            enabled: true,
                            imageUrl: '/assets/img/empty.png',
                            url: ''
                        },
                        {
                            platform: 'trustpilot',
                            label: 'Trustpilot',
                            enabled: true,
                            imageUrl: '/assets/img/empty.png',
                            url: ''
                        },
                        {
                            platform: 'producthunt',
                            label: 'Product Hunt',
                            enabled: false,
                            imageUrl: '/assets/img/empty.png',
                            url: ''
                        }
                    ]
                }
            });

            return {
                ...base,
                init() {
                    this.ensureBadges();
                    this.clampRating();
                },
                ensureBadges() {
                    if (!Array.isArray(this.config.badges))
                    {
                        this.config.badges = [];
                    }
                },
                clampRating() {
                    const max = Number(this.config.maxRating);

                    if (!Number.isFinite(max) || max <= 0)
                    {
                        this.config.maxRating = 5;
                    }

                    const rating = Number(this.config.rating);

                    if (!Number.isFinite(rating))
                    {
                        this.config.rating = 0;
                        return;
                    }

                    if (rating < 0)
                    {
                        this.config.rating = 0;
                        return;
                    }

                    if (rating > this.config.maxRating)
                    {
                        this.config.rating = this.config.maxRating;
                    }
                }
            };
      })()"
      @set="setConfig"
      @get="getConfig"
>
    <ul class="nav nav-tabs" role="tablist">
        <li class="nav-item"><a class="nav-link active" data-bs-toggle="tab" href="#social-proof-bar-rating" role="tab">Rating</a></li>
        <li class="nav-item"><a class="nav-link" data-bs-toggle="tab" href="#social-proof-bar-badges" role="tab">Badges</a></li>
        <li class="nav-item"><a class="nav-link" data-bs-toggle="tab" href="#social-proof-bar-layout" role="tab">Layout</a></li>
        <li class="nav-item"><a class="nav-link" data-bs-toggle="tab" href="#social-proof-bar-show-hide" role="tab">Show/Hide</a></li>
        {{> common/dialogs/basic_nav }}
    </ul>

    <div class="tab-content">
        <div class="tab-pane show active" id="social-proof-bar-rating" role="tabpanel">
            <div class="p-3 bg-light border rounded mt-3">
                <div class="mb-3">
                    <label class="form-label">Aggregate rating</label>
                    <input
                        type="number"
                        class="form-control"
                        x-model.number="config.rating"
                        min="0"
                        :max="config.maxRating"
                        step="0.1"
                        @change="clampRating()"
                    >
                    <p class="form-text text-muted mb-0 small">Displayed as stars and numeric score (e.g. 4.8 / 5).</p>
                </div>
                <div class="mb-0">
                    <label class="form-label">Maximum rating</label>
                    <select class="form-select" x-model.number="config.maxRating" @change="clampRating()">
                        <option value="5">5 stars</option>
                        <option value="10">10 point scale</option>
                    </select>
                </div>
            </div>
        </div>

        <div class="tab-pane" id="social-proof-bar-badges" role="tabpanel">
            <div class="mt-3">
                <p class="form-text text-muted mb-3">Toggle platform badges and set labels or logo images. Review count copy is edited inline on the section.</p>

                <div class="d-flex flex-column gap-3">
                    <template x-for="(badge, badgeIndex) in (config.badges || [])" :key="badge.platform || badgeIndex">
                        <div class="p-3 border rounded bg-light">
                            <div class="d-flex justify-content-between align-items-start gap-2 mb-3 flex-wrap">
                                <h6 class="mb-0" x-text="badge.label || badge.platform || `Badge ${badgeIndex + 1}`"></h6>
                                <div class="form-check form-switch mb-0">
                                    <input
                                        class="form-check-input"
                                        type="checkbox"
                                        :id="`socialProofBadgeEnabled-${badgeIndex}`"
                                        x-model="badge.enabled"
                                    >
                                    <label class="form-check-label small" :for="`socialProofBadgeEnabled-${badgeIndex}`">Show badge</label>
                                </div>
                            </div>

                            <div class="mb-2">
                                <label class="form-label small mb-1">Platform label</label>
                                <input type="text" class="form-control form-control-sm" x-model="badge.label" placeholder="G2">
                            </div>

                            <div class="mb-2">
                                <label class="form-label small mb-1">Badge image URL</label>
                                <input type="text" class="form-control form-control-sm" x-model="badge.imageUrl" placeholder="/assets/img/empty.png">
                            </div>

                            <div class="mb-0">
                                <label class="form-label small mb-1">Link URL (optional)</label>
                                <input type="text" class="form-control form-control-sm" x-model="badge.url" placeholder="https://www.g2.com/products/...">
                            </div>
                        </div>
                    </template>
                </div>
            </div>
        </div>

        <div class="tab-pane" id="social-proof-bar-layout" role="tabpanel">
            <div class="p-3 bg-light border rounded mt-3">
                <div class="form-check mb-0">
                    <input class="form-check-input" type="checkbox" x-model="config.centerContent" id="socialProofBarCenterContent">
                    <label class="form-check-label" for="socialProofBarCenterContent">Centre content</label>
                </div>
            </div>
        </div>

        <div class="tab-pane" id="social-proof-bar-show-hide" role="tabpanel">
            <div class="p-3 bg-light border rounded mt-3">
                <div class="form-check mb-3">
                    <input class="form-check-input" type="checkbox" x-model="config.hideRating" id="socialProofBarHideRating">
                    <label class="form-check-label" for="socialProofBarHideRating">Hide star rating</label>
                </div>
                <div class="form-check mb-3">
                    <input class="form-check-input" type="checkbox" x-model="config.hideReviewCount" id="socialProofBarHideReviewCount">
                    <label class="form-check-label" for="socialProofBarHideReviewCount">Hide review count text</label>
                </div>
                <div class="form-check mb-0">
                    <input class="form-check-input" type="checkbox" x-model="config.hideBadges" id="socialProofBarHideBadges">
                    <label class="form-check-label" for="socialProofBarHideBadges">Hide platform badges</label>
                </div>
            </div>
        </div>

        {{> common/dialogs/basic_content hideAlternateBackground=false }}
    </div>
</form>
