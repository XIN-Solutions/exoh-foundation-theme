{{let . resolvedItems=(?? items config.items)}}
{{let .
      selectedColumnSetting=(?? config.columns 'three')
      columnsMap=(map two='col-12 col-md-6' three='col-12 col-md-6 col-lg-4')
      selectedColumns=(lookup columnsMap selectedColumnSetting)
}}

<section
    class="
        portfolio
        {{?: config.useAltBackground 'bg--alternate' ''}}
        spacing--{{?? config.spacing 'comfortable'}}
        {{?: config.noTopSpacing 'spacing--no-top' ''}}
        {{?: config.noBottomSpacing 'spacing--no-bottom' ''}}
    "
    no-edit="children"
    allowadd="no"
    allowdelete="no"
>
    <div class="container">
        {{#unless config.hideTitle}}
            <div class="row justify-content-center mb-4 mb-lg-5">
                <div class="col-lg-8 {{?: config.centerTitle 'text-center' 'text-start'}}">
                    <h2 class="mb-0 h2-all" edit="title innerHTML">
                        {{{?? title "Selected work"}}}
                    </h2>
                </div>
            </div>
        {{/unless}}

        {{#if config.showFilterTags}}
            {{#if config.filterCategories.length}}
                <div class="row justify-content-center mb-4">
                    <div class="col-lg-10 {{?: config.centerTitle 'text-center' 'text-start'}}">
                        <div class="d-flex flex-wrap gap-2 {{?: config.centerTitle 'justify-content-center' 'justify-content-start'}}">
                            {{#each config.filterCategories}}
                                <span class="badge text-bg-light border paragraphColor-text fw-normal">{{this}}</span>
                            {{/each}}
                        </div>
                    </div>
                </div>
            {{/if}}
        {{/if}}

        {{#if resolvedItems.length}}
            <div class="row g-4">
                {{#each resolvedItems}}
                    <div class="{{../selectedColumns}}">
                        <article class="card h-100 border-0 shadow-sm">
                            <a href="{{?? url '#'}}" class="d-block">
                                <img
                                    src="{{?? imageUrl '/assets/img/empty.png'}}"
                                    alt="{{?? imageAlt ''}}"
                                    loading="lazy"
                                    class="card-img-top img-fluid ratio-4-3"
                                    data-image-hint="width=640"
                                >
                            </a>
                            <div class="card-body d-flex flex-column">
                                {{#unless ../config.hideCategory}}
                                    {{#if category}}
                                        <p class="mb-2">
                                            <span class="badge tertiaryColor-bg altBackgroundColor-text text-uppercase small fw-semibold">{{category}}</span>
                                        </p>
                                    {{/if}}
                                {{/unless}}
                                <h3 class="card-title h5 mb-2">
                                    <a class="text-reset text-decoration-none" href="{{?? url '#'}}">
                                        {{?? title "Project title"}}
                                    </a>
                                </h3>
                                <p class="card-text paragraphColor-text mb-4">
                                    {{?? description "Brief summary of the project outcome and client context."}}
                                </p>
                                <a
                                    class="btn buttonColor-bg align-self-start mt-auto"
                                    href="{{?? url '#'}}"
                                    role="button"
                                >
                                    <span>{{?? linkText "View case study"}}</span>
                                    <i no-edit class="la la-long-arrow-alt-right ms-1"></i>
                                </a>
                            </div>
                        </article>
                    </div>
                {{/each}}
            </div>
        {{else}}
            <div class="alert alert-warning mb-0" role="alert">
                No projects configured yet.
            </div>
        {{/if}}
    </div>
</section>
