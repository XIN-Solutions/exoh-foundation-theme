{{let .
      isContentLeft=(eq (?? config.contentPosition "left") "left")
      isSubscribe=(eq (?? config.formType "subscribe") "subscribe")
}}

<section
    class="
        split-cta-form
        {{?: config.useAltBackground 'bg--alternate' ''}}
        spacing--{{?? config.spacing 'comfortable'}}
        {{?: config.noTopSpacing 'spacing--no-top' ''}}
        {{?: config.noBottomSpacing 'spacing--no-bottom' ''}}
    "
    no-edit="children"
    allowadd="no"
    allowdelete="no"
>
    <div class="container">
        <div class="row align-items-center gy-5">
            {{#if isContentLeft}}
                {{> copyCol}}
                {{> formCol}}
            {{else}}
                {{> formCol orderClass="order-first order-lg-0"}}
                {{> copyCol orderClass="order-last order-lg-0"}}
            {{/if}}
        </div>
    </div>
</section>

{{#*inline "copyCol"}}
    <div class="col-lg-6 {{orderClass}}">
        {{#unless config.hideTitle}}
            <h2 class="mb-3 h2-all" edit="title innerHTML">
                {{{?? title "Start your free trial today"}}}
            </h2>
        {{/unless}}

        {{#unless config.hideDescription}}
            <p class="lead mb-4 h3-all" edit="description innerHTML">
                {{{?? description "Join thousands of teams already using our platform. Get started in minutes — no credit card required."}}}
            </p>
        {{/unless}}

        {{#unless config.hideSecondaryLink}}
            <a
                edit="
                    secondaryLinkLabel span,
                    secondaryLinkClasses @class,
                    secondaryLinkUrl @href,
                    secondaryLinkTitle @title,
                    secondaryLinkTarget @target,
                    secondaryLinkRel @rel
                "
                class="{{?? secondaryLinkClasses 'link link-underline-opacity-100'}}"
                href="{{?? secondaryLinkUrl '#'}}"
                title="{{secondaryLinkTitle}}"
                target="{{secondaryLinkTarget}}"
                rel="{{secondaryLinkRel}}"
            >
                <span>{{{?? secondaryLinkLabel "Learn more about our plans"}}}</span>
            </a>
        {{/unless}}
    </div>
{{/inline}}

{{#*inline "formCol"}}
    <div class="col-lg-6 {{orderClass}}">
        <div class="card border shadow-sm p-4 p-lg-5">
            {{#if isSubscribe}}
                <form
                    class="split-cta-form__subscribe"
                    action="{{?? formAction '#'}}"
                    method="post"
                >
                    {{#unless config.hideName}}
                        <div class="mb-3">
                            <label class="form-label small fw-semibold mb-1" for="split-cta-name">
                                {{?? config.nameLabel "Full name"}}
                            </label>
                            <input
                                id="split-cta-name"
                                class="form-control"
                                type="text"
                                name="name"
                                placeholder="{{?? config.namePlaceholder 'Jane Smith'}}"
                                autocomplete="name"
                                required
                            >
                        </div>
                    {{/unless}}

                    <div class="mb-3">
                        <label class="form-label small fw-semibold mb-1" for="split-cta-email">
                            {{?? config.emailLabel "Email address"}}
                        </label>
                        <input
                            id="split-cta-email"
                            class="form-control"
                            type="email"
                            name="email"
                            placeholder="{{?? config.emailPlaceholder 'you@company.com'}}"
                            autocomplete="email"
                            required
                        >
                    </div>

                    <button
                        class="btn buttonColor-bg altBackgroundColor-text w-100"
                        type="submit"
                        edit="buttonLabel innerHTML"
                    >
                        {{{?? buttonLabel "Get started"}}}
                    </button>

                    {{#unless config.hidePrivacyNote}}
                        <p class="small text-muted mt-3 mb-0">
                            {{{?? config.privacyNote "We respect your privacy. Unsubscribe at any time."}}}
                        </p>
                    {{/unless}}
                </form>
            {{else}}
                <form
                    class="split-cta-form__contact"
                    hx-post="/contact"
                    hx-disabled-elt="find button"
                >
                    <div class="mb-3">
                        <label class="form-label small fw-semibold mb-1" for="split-cta-contact-name">
                            {{?? config.nameLabel "Name"}}
                        </label>
                        <input
                            id="split-cta-contact-name"
                            class="form-control"
                            type="text"
                            name="name"
                            required
                        >
                    </div>

                    <div class="mb-3">
                        <label class="form-label small fw-semibold mb-1" for="split-cta-contact-email">
                            {{?? config.emailLabel "Email address"}}
                        </label>
                        <input
                            id="split-cta-contact-email"
                            class="form-control"
                            type="email"
                            name="email"
                            required
                        >
                    </div>

                    <div class="mb-3">
                        <label class="form-label small fw-semibold mb-1" for="split-cta-contact-message">
                            {{?? config.messageLabel "How can we help?"}}
                        </label>
                        <textarea
                            id="split-cta-contact-message"
                            class="form-control"
                            name="message"
                            rows="3"
                            required
                        ></textarea>
                    </div>

                    <button
                        class="btn buttonColor-bg altBackgroundColor-text w-100"
                        type="submit"
                        edit="buttonLabel innerHTML"
                    >
                        {{{?? buttonLabel "Send message"}}}
                    </button>
                </form>
            {{/if}}
        </div>
    </div>
{{/inline}}
