<form class="config-form"
      x-data="(() => {
            const base = componentDialog({
                defaultConfig: {
                    instanceId: '',
                    message: 'Limited-time offer: save 20% on annual plans. <strong>Offer ends Friday.</strong>',
                    linkUrl: '#',
                    linkLabel: 'Learn more',
                    dismissible: true,
                    colorVariant: 'primary',
                    hideLink: false,
                    spacing: 'compact',
                    noTopSpacing: false,
                    noBottomSpacing: false
                }
            });

            return {
                ...base,
                init() {
                    if (!this.config.instanceId)
                    {
                        this.config.instanceId = 'announcement-' + Math.random().toString(36).slice(2, 10);
                    }
                }
            };
      })()"
      @set="setConfig"
      @get="getConfig"
>
    <ul class="nav nav-tabs" role="tablist">
        <li class="nav-item"><a class="nav-link active" data-bs-toggle="tab" href="#announcement-banner-content" role="tab">Content</a></li>
        <li class="nav-item"><a class="nav-link" data-bs-toggle="tab" href="#announcement-banner-layout" role="tab">Layout</a></li>
        <li class="nav-item"><a class="nav-link" data-bs-toggle="tab" href="#announcement-banner-show-hide" role="tab">Show/Hide</a></li>
        {{> common/dialogs/basic_nav }}
    </ul>

    <div class="tab-content">
        <div class="tab-pane show active" id="announcement-banner-content" role="tabpanel">
            <div class="p-3 bg-light border rounded mt-3">
                <div class="mb-3">
                    <label class="form-label">Message</label>
                    <textarea
                        class="form-control"
                        rows="3"
                        x-model="config.message"
                        placeholder="Limited-time offer: save 20% on annual plans."
                    ></textarea>
                    <p class="form-text text-muted mb-0 small">Supports basic HTML (e.g. &lt;strong&gt;). Message can also be edited inline on the section.</p>
                </div>

                <div class="mb-3">
                    <label class="form-label">Link label</label>
                    <input type="text" class="form-control" x-model="config.linkLabel" placeholder="Learn more">
                </div>

                <div class="mb-3">
                    <label class="form-label">Link URL</label>
                    <input type="text" class="form-control" x-model="config.linkUrl" placeholder="https://example.com/offer">
                    <p class="form-text text-muted mb-0 small">Leave empty or set to <code>#</code> to hide the link when Show/Hide disables it.</p>
                </div>

                <div class="form-check mb-0">
                    <input class="form-check-input" type="checkbox" x-model="config.dismissible" id="announcementBannerDismissible">
                    <label class="form-check-label" for="announcementBannerDismissible">Show dismiss button</label>
                    <p class="form-text text-muted mb-0 small">Dismiss state is stored for the current browser session only (not persisted across visits in v1).</p>
                </div>
            </div>
        </div>

        <div class="tab-pane" id="announcement-banner-layout" role="tabpanel">
            <div class="p-3 bg-light border rounded mt-3">
                <div class="mb-0">
                    <label class="form-label">Colour variant</label>
                    <select class="form-select" x-model="config.colorVariant">
                        <option value="primary">Primary brand colour</option>
                        <option value="alternate">Light alternate background</option>
                        <option value="accent">Accent / tertiary colour</option>
                    </select>
                </div>
            </div>
        </div>

        <div class="tab-pane" id="announcement-banner-show-hide" role="tabpanel">
            <div class="p-3 bg-light border rounded mt-3">
                <div class="form-check mb-0">
                    <input class="form-check-input" type="checkbox" x-model="config.hideLink" id="announcementBannerHideLink">
                    <label class="form-check-label" for="announcementBannerHideLink">Hide optional link</label>
                </div>
            </div>
        </div>

        {{> common/dialogs/basic_content hideAlternateBackground=true }}
    </div>
</form>
