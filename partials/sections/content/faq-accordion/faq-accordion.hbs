{{let . resolvedItems=(?? items config.items)}}
{{let . accordionId=(?? config.instanceId 'faq')}}

<section
    class="
        faq-accordion
        {{?: config.useAltBackground 'bg--alternate' ''}}
        spacing--{{?? config.spacing 'comfortable'}}
        {{?: config.noTopSpacing 'spacing--no-top' ''}}
        {{?: config.noBottomSpacing 'spacing--no-bottom' ''}}
    "
    no-edit="children"
    allowadd="no"
    allowdelete="no"
>
    <div class="container">
        {{#unless config.hideTitle}}
            <div class="row justify-content-center mb-4">
                <div class="col-lg-8 {{?: config.centerTitle 'text-center' 'text-start'}}">
                    <h2 class="mb-3 h2-all" edit="title innerHTML">
                        {{{?? title "Lorem ipsum dolor sit amet"}}}
                    </h2>
                    {{#unless config.hideDescription}}
                        <p class="lead mb-0 h3-all" edit="description innerHTML">
                            {{{?? description "Lorem ipsum dolor sit amet, consectetur adipiscing elit. Maecenas cursus in lectus ut dignissim."}}}
                        </p>
                    {{/unless}}
                </div>
            </div>
        {{/unless}}

        <div class="row justify-content-center">
            <div class="col-lg-8">
                {{#if resolvedItems.length}}
                    <div class="faq-accordion__list w-100" id="faq-accordion-{{accordionId}}">
                        {{#each resolvedItems}}
                            <div class="faq-accordion__item backgroundColor-bg w-100 border mb-2" style="border-radius: var(--theme-cardBorderRadius);">
                                <h3 class="faq-accordion__header mb-0" id="faq-heading-{{../accordionId}}-{{@index}}">
                                    <button
                                        class="faq-accordion__button h3Color-text w-100 d-flex align-items-center justify-content-between border-0 bg-transparent p-3 text-start {{?: (and ../config.expandFirst (eq @index 0)) '' 'collapsed'}}"
                                        type="button"
                                        style="appearance: none; -webkit-appearance: none;"
                                        data-bs-toggle="collapse"
                                        data-bs-target="#faq-collapse-{{../accordionId}}-{{@index}}"
                                        aria-expanded="{{?: (and ../config.expandFirst (eq @index 0)) 'true' 'false'}}"
                                        aria-controls="faq-collapse-{{../accordionId}}-{{@index}}"
                                    >
                                        <span class="faq-accordion__question">{{?? question "Lorem ipsum dolor sit amet?"}}</span>
                                        <svg class="faq-accordion__icon flex-shrink-0" width="12" height="12" viewBox="0 0 12 12" aria-hidden="true" focusable="false">
                                            <path d="M2 4l4 4 4-4" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"></path>
                                        </svg>
                                    </button>
                                </h3>
                                <div
                                    id="faq-collapse-{{../accordionId}}-{{@index}}"
                                    class="collapse {{?: (and ../config.expandFirst (eq @index 0)) 'show' ''}}"
                                    aria-labelledby="faq-heading-{{../accordionId}}-{{@index}}"
                                    data-bs-parent="#faq-accordion-{{../accordionId}}"
                                >
                                    <div class="faq-accordion__body paragraphColor-text px-3 pb-3">
                                        {{{markdown-to-html (?? answer "Consectetur adipiscing elit. Maecenas cursus in lectus ut dignissim.")}}}
                                    </div>
                                </div>
                            </div>
                        {{/each}}
                    </div>
                {{else}}
                    <div class="alert alert-warning mb-0" role="alert">
                        No FAQ items configured yet.
                    </div>
                {{/if}}
            </div>
        </div>
    </div>

    {{#if resolvedItems.length}}
        <script type="application/ld+json">
{
    "@context": "https://schema.org",
    "@type": "FAQPage",
    "mainEntity": [
        {{#each resolvedItems}}
        {
            "@type": "Question",
            "name": {{{jsonflat (?? question "Lorem ipsum dolor sit amet?")}}},
            "acceptedAnswer": {
                "@type": "Answer",
                "text": {{{jsonflat (markdown-to-html (?? answer "Consectetur adipiscing elit. Maecenas cursus in lectus ut dignissim."))}}}
            }
        }{{#unless @last}},{{/unless}}
        {{/each}}
    ]
}
        </script>
    {{/if}}
</section>
