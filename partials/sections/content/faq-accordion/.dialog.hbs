<form class="config-form"
      x-data="(() => {
            const MIN_ITEMS = 1;
            const MAX_ITEMS = 20;

            const base = componentDialog({
                defaultConfig: {
                    instanceId: '',
                    expandFirst: true,
                    centerTitle: true,
                    hideTitle: false,
                    hideDescription: false,
                    useAltBackground: false,
                    spacing: 'comfortable',
                    noTopSpacing: false,
                    noBottomSpacing: false,
                    items: [
                        {
                            question: 'What is included in the free plan?',
                            answer: 'The free plan includes core features for individuals and small teams getting started.'
                        },
                        {
                            question: 'Can I change plans later?',
                            answer: 'Yes. You can upgrade or downgrade at any time from your account settings.'
                        },
                        {
                            question: 'Do you offer refunds?',
                            answer: 'We offer a 30-day money-back guarantee on annual subscriptions.'
                        }
                    ]
                }
            });

            return {
                ...base,
                minItems: MIN_ITEMS,
                maxItems: MAX_ITEMS,
                init() {
                    if (!this.config.instanceId)
                    {
                        this.config.instanceId = 'faq-' + Math.random().toString(36).slice(2, 9);
                    }

                    this.ensureItems();
                },
                ensureItems() {
                    if (!Array.isArray(this.config.items))
                    {
                        this.config.items = [];
                    }

                    while (this.config.items.length < MIN_ITEMS)
                    {
                        this.config.items.push({
                            question: 'New question',
                            answer: 'Answer text goes here.'
                        });
                    }

                    if (this.config.items.length > MAX_ITEMS)
                    {
                        this.config.items = this.config.items.slice(0, MAX_ITEMS);
                    }
                },
                addItem() {
                    this.ensureItems();

                    if (this.config.items.length >= MAX_ITEMS)
                    {
                        return;
                    }

                    this.config.items.push({
                        question: 'New question',
                        answer: 'Answer text goes here.'
                    });
                },
                removeItem(index) {
                    if (!Array.isArray(this.config.items))
                    {
                        return;
                    }

                    if (this.config.items.length <= MIN_ITEMS)
                    {
                        return;
                    }

                    this.config.items.splice(index, 1);
                },
                moveItem(fromIndex, toIndex) {
                    if (!Array.isArray(this.config.items))
                    {
                        return;
                    }

                    if (fromIndex < 0 || toIndex < 0)
                    {
                        return;
                    }

                    if (fromIndex >= this.config.items.length || toIndex >= this.config.items.length)
                    {
                        return;
                    }

                    if (fromIndex === toIndex)
                    {
                        return;
                    }

                    const next = [...this.config.items];
                    const [moved] = next.splice(fromIndex, 1);
                    next.splice(toIndex, 0, moved);
                    this.config.items = next;
                }
            };
      })()"
      @set="setConfig"
      @get="getConfig"
>
    <ul class="nav nav-tabs" role="tablist">
        <li class="nav-item"><a class="nav-link active" data-bs-toggle="tab" href="#faq-items" role="tab">FAQ items</a></li>
        <li class="nav-item"><a class="nav-link" data-bs-toggle="tab" href="#faq-layout" role="tab">Layout</a></li>
        <li class="nav-item"><a class="nav-link" data-bs-toggle="tab" href="#faq-show-hide" role="tab">Show/Hide</a></li>
        {{> common/dialogs/basic_nav }}
    </ul>

    <div class="tab-content">
        <div class="tab-pane show active" id="faq-items" role="tabpanel">
            <div class="mt-3">
                <div class="d-flex justify-content-between align-items-center gap-2 flex-wrap mb-3">
                    <div>
                        <label class="form-label mb-0">Questions and answers</label>
                        <p class="form-text text-muted mb-0 small">Add, remove, and reorder FAQ pairs. Between <span x-text="minItems"></span> and <span x-text="maxItems"></span> items.</p>
                    </div>
                    <button
                        type="button"
                        class="btn btn-primary btn-sm"
                        @click="addItem()"
                        :disabled="(config.items || []).length >= maxItems"
                    >
                        Add item
                    </button>
                </div>

                <div class="d-flex flex-column gap-3">
                    <template x-for="(item, itemIndex) in (config.items || [])" :key="itemIndex">
                        <div class="p-3 border rounded bg-light">
                            <div class="d-flex justify-content-between align-items-start gap-2 mb-3 flex-wrap">
                                <h6 class="mb-0" x-text="item.question || `FAQ item ${itemIndex + 1}`"></h6>
                                <div class="btn-group btn-group-sm">
                                    <button type="button" class="btn btn-outline-secondary" @click="moveItem(itemIndex, itemIndex - 1)" :disabled="itemIndex === 0" aria-label="Move item up" title="Move item up">▲</button>
                                    <button type="button" class="btn btn-outline-secondary" @click="moveItem(itemIndex, itemIndex + 1)" :disabled="itemIndex === (config.items.length - 1)" aria-label="Move item down" title="Move item down">▼</button>
                                    <button type="button" class="btn btn-outline-danger" @click="removeItem(itemIndex)" :disabled="config.items.length <= minItems" aria-label="Remove item" title="Remove item">✕</button>
                                </div>
                            </div>

                            <div class="mb-2">
                                <label class="form-label small mb-1">Question</label>
                                <input type="text" class="form-control form-control-sm" x-model="item.question" placeholder="Question text">
                            </div>

                            <div class="mb-0">
                                <label class="form-label small mb-1">Answer</label>
                                <textarea class="form-control form-control-sm" rows="3" x-model="item.answer" placeholder="Answer text"></textarea>
                            </div>
                        </div>
                    </template>
                </div>
            </div>
        </div>

        <div class="tab-pane" id="faq-layout" role="tabpanel">
            <div class="p-3 bg-light border rounded mt-3">
                <div class="form-check mb-3">
                    <input class="form-check-input" type="checkbox" x-model="config.expandFirst" id="faqExpandFirst">
                    <label class="form-check-label" for="faqExpandFirst">Expand first item by default</label>
                </div>
                <div class="form-check mb-0">
                    <input class="form-check-input" type="checkbox" x-model="config.centerTitle" id="faqCenterTitle">
                    <label class="form-check-label" for="faqCenterTitle">Center section title</label>
                </div>
            </div>
        </div>

        <div class="tab-pane" id="faq-show-hide" role="tabpanel">
            <div class="p-3 bg-light border rounded mt-3">
                <div class="mb-3"><div class="form-check"><input class="form-check-input" type="checkbox" x-model="config.hideTitle" id="faqHideTitle"><label class="form-check-label" for="faqHideTitle">Hide section title</label></div></div>
                <div class="mb-0"><div class="form-check"><input class="form-check-input" type="checkbox" x-model="config.hideDescription" id="faqHideDescription"><label class="form-check-label" for="faqHideDescription">Hide description</label></div></div>
            </div>
        </div>

        {{> common/dialogs/basic_content hideAlternateBackground=false }}
    </div>
</form>
