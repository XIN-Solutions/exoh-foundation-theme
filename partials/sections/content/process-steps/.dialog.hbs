<form class="config-form"
      x-data="(() => {
            const MAX_ITEMS = 5;

            const base = componentDialog({
                defaultConfig: {
                    orientation: 'horizontal',
                    markerStyle: 'number',
                    centerTitle: true,
                    centerSteps: true,
                    hideTitle: false,
                    hideDescription: false,
                    useAltBackground: false,
                    spacing: 'comfortable',
                    noTopSpacing: false,
                    noBottomSpacing: false,
                    items: []
                }
            });

            return {
                ...base,
                maxItems: MAX_ITEMS,
                init() {
                    if (typeof base.init === 'function')
                    {
                        base.init.call(this);
                    }

                    this.ensureItems();
                },
                ensureItems() {
                    if (!Array.isArray(this.config.items))
                    {
                        this.config.items = [];
                    }

                    if (this.config.items.length > MAX_ITEMS)
                    {
                        this.config.items = this.config.items.slice(0, MAX_ITEMS);
                    }
                },
                addItem() {
                    this.ensureItems();

                    if (this.config.items.length >= MAX_ITEMS)
                    {
                        return;
                    }

                    this.config.items.push({
                        title: '',
                        description: '',
                        iconClass: 'la la-check'
                    });
                },
                removeItem(index) {
                    if (!Array.isArray(this.config.items))
                    {
                        return;
                    }

                    this.config.items.splice(index, 1);
                },
                moveItem(fromIndex, toIndex) {
                    if (!Array.isArray(this.config.items))
                    {
                        return;
                    }

                    if (fromIndex < 0 || toIndex < 0)
                    {
                        return;
                    }

                    if (fromIndex >= this.config.items.length || toIndex >= this.config.items.length)
                    {
                        return;
                    }

                    if (fromIndex === toIndex)
                    {
                        return;
                    }

                    const next = [...this.config.items];
                    const [moved] = next.splice(fromIndex, 1);
                    next.splice(toIndex, 0, moved);
                    this.config.items = next;
                }
            };
      })()"
      @set="setConfig"
      @get="getConfig"
>
    <ul class="nav nav-tabs" role="tablist">
        <li class="nav-item"><a class="nav-link active" data-bs-toggle="tab" href="#process-steps-items" role="tab">Steps</a></li>
        <li class="nav-item"><a class="nav-link" data-bs-toggle="tab" href="#process-steps-layout" role="tab">Layout</a></li>
        <li class="nav-item"><a class="nav-link" data-bs-toggle="tab" href="#process-steps-show-hide" role="tab">Show/Hide</a></li>
        {{> common/dialogs/basic_nav }}
    </ul>

    <div class="tab-content">
        <div class="tab-pane show active" id="process-steps-items" role="tabpanel">
            <div class="mt-3">
                <div class="d-flex justify-content-between align-items-center gap-2 flex-wrap mb-3">
                    <div>
                        <label class="form-label mb-0">Process steps</label>
                        <p class="form-text text-muted mb-0 small">Add, remove, and reorder steps. Up to <span x-text="maxItems"></span> items.</p>
                    </div>
                    <button
                        type="button"
                        class="btn btn-primary btn-sm"
                        @click="addItem()"
                        :disabled="(config.items || []).length >= maxItems"
                    >
                        Add step
                    </button>
                </div>

                <template x-if="!(config.items || []).length">
                    <div class="alert alert-warning mb-0" role="alert">
                        No process steps configured yet.
                    </div>
                </template>

                <div class="d-flex flex-column gap-3" x-show="(config.items || []).length">
                    <template x-for="(item, itemIndex) in (config.items || [])" :key="itemIndex">
                        <div class="p-3 border rounded bg-body-secondary">
                            <div class="d-flex justify-content-between align-items-start gap-2 mb-3 flex-wrap">
                                <h6 class="mb-0" x-text="item.title || `Step ${itemIndex + 1}`"></h6>
                                <div class="btn-group btn-group-sm">
                                    <button type="button" class="btn btn-outline-secondary" @click="moveItem(itemIndex, itemIndex - 1)" :disabled="itemIndex === 0" aria-label="Move step up" title="Move step up">▲</button>
                                    <button type="button" class="btn btn-outline-secondary" @click="moveItem(itemIndex, itemIndex + 1)" :disabled="itemIndex === (config.items.length - 1)" aria-label="Move step down" title="Move step down">▼</button>
                                    <button type="button" class="btn btn-outline-danger" @click="removeItem(itemIndex)" aria-label="Remove step" title="Remove step">✕</button>
                                </div>
                            </div>

                            <div class="mb-2">
                                <label class="form-label small mb-1">Title</label>
                                <input type="text" class="form-control form-control-sm" x-model="item.title" placeholder="Step title">
                            </div>

                            <div class="mb-2">
                                <label class="form-label small mb-1">Description</label>
                                <textarea class="form-control form-control-sm" rows="2" x-model="item.description" placeholder="Brief description"></textarea>
                            </div>

                            <div class="mb-0" x-show="config.markerStyle === 'icon'">
                                <label class="form-label small mb-1">Icon class</label>
                                <input type="text" class="form-control form-control-sm" x-model="item.iconClass" placeholder="e.g. la la-check">
                                <p class="form-text text-muted mb-0 small">Line Awesome class used when marker style is set to icons.</p>
                            </div>
                        </div>
                    </template>
                </div>
            </div>
        </div>

        <div class="tab-pane" id="process-steps-layout" role="tabpanel">
            <div class="p-3 bg-body-secondary border rounded mt-3">
                <div class="mb-3">
                    <label class="form-label">Orientation</label>
                    <select class="form-select" x-model="config.orientation">
                        <option value="horizontal">Horizontal (side by side)</option>
                        <option value="vertical">Vertical (stacked)</option>
                    </select>
                </div>
                <div class="mb-3">
                    <label class="form-label">Marker style</label>
                    <select class="form-select" x-model="config.markerStyle">
                        <option value="number">Numbered steps</option>
                        <option value="icon">Icons</option>
                    </select>
                </div>
                <div class="form-check mb-3">
                    <input class="form-check-input" type="checkbox" x-model="config.centerTitle" id="processStepsCenterTitle">
                    <label class="form-check-label" for="processStepsCenterTitle">Center section title</label>
                </div>
                <div class="form-check mb-0">
                    <input class="form-check-input" type="checkbox" x-model="config.centerSteps" id="processStepsCenterSteps">
                    <label class="form-check-label" for="processStepsCenterSteps">Center step content</label>
                </div>
            </div>
        </div>

        <div class="tab-pane" id="process-steps-show-hide" role="tabpanel">
            <div class="p-3 bg-body-secondary border rounded mt-3">
                <div class="form-check mb-3">
                    <input class="form-check-input" type="checkbox" x-model="config.hideTitle" id="processStepsHideTitle">
                    <label class="form-check-label" for="processStepsHideTitle">Hide section title</label>
                </div>
                <div class="form-check mb-0">
                    <input class="form-check-input" type="checkbox" x-model="config.hideDescription" id="processStepsHideDescription">
                    <label class="form-check-label" for="processStepsHideDescription">Hide section description</label>
                </div>
            </div>
        </div>

        {{> common/dialogs/basic_content hideAlternateBackground=false }}
    </div>
</form>
