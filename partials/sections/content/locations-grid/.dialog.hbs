<form class="config-form"
      x-data="(() => {
            const MIN_ITEMS = 2;
            const MAX_ITEMS = 6;

            const base = componentDialog({
                defaultConfig: {
                    columns: 'three',
                    showMapLinks: true,
                    centerTitle: true,
                    hideTitle: false,
                    useAltBackground: false,
                    spacing: 'comfortable',
                    noTopSpacing: false,
                    noBottomSpacing: false,
                    items: [
                        {
                            name: 'Auckland HQ',
                            address: 'Level 12, 45 Queen Street\nAuckland 1010, New Zealand',
                            phone: '+64 9 555 0100',
                            email: 'auckland@example.com',
                            mapUrl: 'https://maps.google.com/?q=-36.8485,174.7633',
                            mapLinkText: 'View on map'
                        },
                        {
                            name: 'Sydney Office',
                            address: 'Suite 8, 100 George Street\nSydney NSW 2000, Australia',
                            phone: '+61 2 5550 2000',
                            email: 'sydney@example.com',
                            mapUrl: 'https://maps.google.com/?q=-33.8688,151.2093',
                            mapLinkText: 'View on map'
                        },
                        {
                            name: 'Singapore Office',
                            address: '1 Raffles Place\nSingapore 048616',
                            phone: '+65 6555 3000',
                            email: 'singapore@example.com',
                            mapUrl: 'https://maps.google.com/?q=1.2834,103.8510',
                            mapLinkText: 'View on map'
                        }
                    ]
                }
            });

            return {
                ...base,
                minItems: MIN_ITEMS,
                maxItems: MAX_ITEMS,
                init() {
                    this.ensureItems();
                },
                ensureItems() {
                    if (!Array.isArray(this.config.items))
                    {
                        this.config.items = [];
                    }

                    while (this.config.items.length < MIN_ITEMS)
                    {
                        this.config.items.push({
                            name: 'Office name',
                            address: 'Street address\nCity, region, postcode',
                            phone: '',
                            email: '',
                            mapUrl: '',
                            mapLinkText: 'View on map'
                        });
                    }

                    if (this.config.items.length > MAX_ITEMS)
                    {
                        this.config.items = this.config.items.slice(0, MAX_ITEMS);
                    }
                },
                addItem() {
                    this.ensureItems();

                    if (this.config.items.length >= MAX_ITEMS)
                    {
                        return;
                    }

                    this.config.items.push({
                        name: 'Office name',
                        address: 'Street address\nCity, region, postcode',
                        phone: '',
                        email: '',
                        mapUrl: '',
                        mapLinkText: 'View on map'
                    });
                },
                removeItem(index) {
                    if (!Array.isArray(this.config.items))
                    {
                        return;
                    }

                    if (this.config.items.length <= MIN_ITEMS)
                    {
                        return;
                    }

                    this.config.items.splice(index, 1);
                },
                moveItem(fromIndex, toIndex) {
                    if (!Array.isArray(this.config.items))
                    {
                        return;
                    }

                    if (fromIndex < 0 || toIndex < 0)
                    {
                        return;
                    }

                    if (fromIndex >= this.config.items.length || toIndex >= this.config.items.length)
                    {
                        return;
                    }

                    if (fromIndex === toIndex)
                    {
                        return;
                    }

                    const next = [...this.config.items];
                    const [moved] = next.splice(fromIndex, 1);
                    next.splice(toIndex, 0, moved);
                    this.config.items = next;
                }
            };
      })()"
      @set="setConfig"
      @get="getConfig"
>
    <ul class="nav nav-tabs" role="tablist">
        <li class="nav-item"><a class="nav-link active" data-bs-toggle="tab" href="#locations-items" role="tab">Locations</a></li>
        <li class="nav-item"><a class="nav-link" data-bs-toggle="tab" href="#locations-layout" role="tab">Layout</a></li>
        <li class="nav-item"><a class="nav-link" data-bs-toggle="tab" href="#locations-show-hide" role="tab">Show/Hide</a></li>
        {{> common/dialogs/basic_nav }}
    </ul>

    <div class="tab-content">
        <div class="tab-pane show active" id="locations-items" role="tabpanel">
            <div class="mt-3">
                <div class="d-flex justify-content-between align-items-center gap-2 flex-wrap mb-3">
                    <div>
                        <label class="form-label mb-0">Office locations</label>
                        <p class="form-text text-muted mb-0 small">Add, remove, and reorder offices. Between <span x-text="minItems"></span> and <span x-text="maxItems"></span> items.</p>
                    </div>
                    <button
                        type="button"
                        class="btn btn-primary btn-sm"
                        @click="addItem()"
                        :disabled="(config.items || []).length >= maxItems"
                    >
                        Add location
                    </button>
                </div>

                <div class="d-flex flex-column gap-3">
                    <template x-for="(item, itemIndex) in (config.items || [])" :key="itemIndex">
                        <div class="p-3 border rounded bg-light">
                            <div class="d-flex justify-content-between align-items-start gap-2 mb-3 flex-wrap">
                                <h6 class="mb-0" x-text="item.name || `Location ${itemIndex + 1}`"></h6>
                                <div class="btn-group btn-group-sm">
                                    <button type="button" class="btn btn-outline-secondary" @click="moveItem(itemIndex, itemIndex - 1)" :disabled="itemIndex === 0" aria-label="Move location up" title="Move location up">▲</button>
                                    <button type="button" class="btn btn-outline-secondary" @click="moveItem(itemIndex, itemIndex + 1)" :disabled="itemIndex === (config.items.length - 1)" aria-label="Move location down" title="Move location down">▼</button>
                                    <button type="button" class="btn btn-outline-danger" @click="removeItem(itemIndex)" :disabled="config.items.length <= minItems" aria-label="Remove location" title="Remove location">✕</button>
                                </div>
                            </div>

                            <div class="mb-2">
                                <label class="form-label small mb-1">Office name</label>
                                <input type="text" class="form-control form-control-sm" x-model="item.name" placeholder="e.g. Auckland HQ">
                            </div>

                            <div class="mb-2">
                                <label class="form-label small mb-1">Address</label>
                                <textarea class="form-control form-control-sm" rows="2" x-model="item.address" placeholder="Street, city, region, postcode"></textarea>
                            </div>

                            <div class="mb-2">
                                <label class="form-label small mb-1">Phone</label>
                                <input type="text" class="form-control form-control-sm" x-model="item.phone" placeholder="+64 9 555 0100">
                            </div>

                            <div class="mb-2">
                                <label class="form-label small mb-1">Email</label>
                                <input type="email" class="form-control form-control-sm" x-model="item.email" placeholder="office@example.com">
                            </div>

                            <div class="mb-2">
                                <label class="form-label small mb-1">Map link URL</label>
                                <input type="url" class="form-control form-control-sm" x-model="item.mapUrl" placeholder="https://maps.google.com/?q=...">
                            </div>

                            <div class="mb-0">
                                <label class="form-label small mb-1">Map link text</label>
                                <input type="text" class="form-control form-control-sm" x-model="item.mapLinkText" placeholder="View on map">
                            </div>
                        </div>
                    </template>
                </div>
            </div>
        </div>

        <div class="tab-pane" id="locations-layout" role="tabpanel">
            <div class="p-3 bg-light border rounded mt-3">
                <div class="mb-3">
                    <label class="form-label">Columns</label>
                    <select class="form-select" x-model="config.columns">
                        <option value="two">Two columns</option>
                        <option value="three">Three columns</option>
                    </select>
                </div>
                <div class="form-check mb-3">
                    <input class="form-check-input" type="checkbox" x-model="config.showMapLinks" id="locationsShowMapLinks">
                    <label class="form-check-label" for="locationsShowMapLinks">Show map links on cards</label>
                </div>
                <div class="form-check mb-0">
                    <input class="form-check-input" type="checkbox" x-model="config.centerTitle" id="locationsCenterTitle">
                    <label class="form-check-label" for="locationsCenterTitle">Center section title</label>
                </div>
            </div>
        </div>

        <div class="tab-pane" id="locations-show-hide" role="tabpanel">
            <div class="p-3 bg-light border rounded mt-3">
                <div class="form-check mb-0">
                    <input class="form-check-input" type="checkbox" x-model="config.hideTitle" id="locationsHideTitle">
                    <label class="form-check-label" for="locationsHideTitle">Hide section title</label>
                </div>
            </div>
        </div>

        {{> common/dialogs/basic_content hideAlternateBackground=false }}
    </div>
</form>
