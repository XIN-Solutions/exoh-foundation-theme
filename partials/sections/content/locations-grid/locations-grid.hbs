{{let . resolvedItems=(?? items config.items)}}
{{let .
      selectedColumnSetting=(?? config.columns 'three')
      columnsMap=(map two='col-12 col-md-6' three='col-12 col-md-6 col-lg-4')
      selectedColumns=(lookup columnsMap selectedColumnSetting)
}}

<section
    class="
        locations-grid
        {{?: config.useAltBackground 'bg--alternate' ''}}
        spacing--{{?? config.spacing 'comfortable'}}
        {{?: config.noTopSpacing 'spacing--no-top' ''}}
        {{?: config.noBottomSpacing 'spacing--no-bottom' ''}}
    "
    no-edit="children"
    allowadd="no"
    allowdelete="no"
>
    <div class="container">
        {{#unless config.hideTitle}}
            <div class="row justify-content-center mb-4 mb-lg-5">
                <div class="col-lg-8 {{?: config.centerTitle 'text-center' 'text-start'}}">
                    <h2 class="mb-0 h2-all" edit="title innerHTML">
                        {{{?? title "Our offices"}}}
                    </h2>
                </div>
            </div>
        {{/unless}}

        {{#if resolvedItems.length}}
            <div class="row g-4">
                {{#each resolvedItems}}
                    <div class="{{../selectedColumns}}">
                        <article class="card h-100 border-0 shadow-sm">
                            <div class="card-body d-flex flex-column">
                                <h3 class="card-title h5 mb-3">
                                    {{?? name "Office name"}}
                                </h3>

                                {{#if address}}
                                    <p class="mb-3 paragraphColor-text">
                                        <span class="d-block mb-1">
                                            <i no-edit class="la la-lg la-map-marker opacity-50 me-1" aria-hidden="true"></i>
                                            <span class="visually-hidden">Address:</span>
                                        </span>
                                        <span class="paragraphColor-text" style="white-space: pre-line;">{{address}}</span>
                                    </p>
                                {{/if}}

                                {{#if phone}}
                                    <p class="mb-2">
                                        <span><i no-edit class="la la-lg la-phone opacity-50 me-1" aria-hidden="true"></i></span>
                                        <span class="visually-hidden">Phone:</span>
                                        <a href="tel:{{phone}}">{{phone}}</a>
                                    </p>
                                {{/if}}

                                {{#if email}}
                                    <p class="mb-3">
                                        <span><i no-edit class="la la-lg la-envelope opacity-50 me-1" aria-hidden="true"></i></span>
                                        <span class="visually-hidden">Email:</span>
                                        <a href="mailto:{{email}}">{{email}}</a>
                                    </p>
                                {{/if}}

                                {{#if ../config.showMapLinks}}
                                    {{#if mapUrl}}
                                        <a
                                            class="btn btn-outline-primary align-self-start mt-auto"
                                            href="{{mapUrl}}"
                                            target="_blank"
                                            rel="noopener noreferrer"
                                        >
                                            <span>{{?? mapLinkText "View on map"}}</span>
                                            <i no-edit class="la la-external-link-alt ms-1" aria-hidden="true"></i>
                                        </a>
                                    {{/if}}
                                {{/if}}
                            </div>
                        </article>
                    </div>
                {{/each}}
            </div>
        {{else}}
            <div class="alert alert-warning mb-0" role="alert">
                No locations configured yet.
            </div>
        {{/if}}
    </div>
</section>
