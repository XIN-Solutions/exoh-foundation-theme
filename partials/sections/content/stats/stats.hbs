{{let . resolvedItems=(?? items config.items)}}
{{let . selectedColumns=(lookup (map two='col-12 col-md-6' three='col-12 col-md-4' four='col-12 col-sm-6 col-lg-3') (?? config.columns 'four'))}}

<section
    class="
        stats
        {{?: config.useAltBackground 'bg--alternate' ''}}
        spacing--{{?? config.spacing 'comfortable'}}
        {{?: config.noTopSpacing 'spacing--no-top' ''}}
        {{?: config.noBottomSpacing 'spacing--no-bottom' ''}}
    "
    no-edit="children"
    allowadd="no"
    allowdelete="no"
>
    <div class="container">
        {{#unless config.hideTitle}}
            <div class="row justify-content-center mb-4">
                <div class="col-lg-8 {{?: (eq config.centerTitle false) 'text-start' 'text-center'}}">
                    <h2 class="mb-0 h2-all" edit="title innerHTML">
                        {{{?? title "Lorem ipsum dolor sit amet"}}}
                    </h2>
                </div>
            </div>
        {{/unless}}

        <div class="row g-4 justify-content-center">
            {{#if resolvedItems.length}}
                {{#each resolvedItems}}
                    <div class="{{?? ../selectedColumns 'col-12 col-sm-6 col-lg-3'}} {{?: (eq ../config.centerStats false) 'text-start' 'text-center'}}">
                        <div class="stats__item">
                            <p class="stats__value mb-1 fw-bold primaryColor-text">
                                {{#if prefix}}
                                    <span class="stats__prefix">{{prefix}}</span>
                                {{/if}}
                                <span>{{?? value "0"}}</span>
                                {{#if suffix}}
                                    <span class="stats__suffix">{{suffix}}</span>
                                {{/if}}
                            </p>
                            <p class="stats__label mb-0 paragraphColor-text">
                                {{?? label "Lorem ipsum"}}
                            </p>
                        </div>
                    </div>
                {{/each}}
            {{else}}
                <div class="col-12">
                    <div class="alert alert-warning mb-0" role="alert">
                        No stats configured yet.
                    </div>
                </div>
            {{/if}}
        </div>
    </div>
</section>
