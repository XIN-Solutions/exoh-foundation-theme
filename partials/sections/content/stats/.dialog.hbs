<form class="config-form"
      x-data="(() => {
            const MAX_ITEMS = 4;

            const base = componentDialog({
                defaultConfig: {
                    columns: 'four',
                    centerTitle: true,
                    centerStats: true,
                    hideTitle: false,
                    useAltBackground: false,
                    spacing: 'comfortable',
                    noTopSpacing: false,
                    noBottomSpacing: false,
                    items: []
                }
            });

            return {
                ...base,
                maxItems: MAX_ITEMS,
                init() {
                    if (typeof base.init === 'function')
                    {
                        base.init.call(this);
                    }

                    this.ensureItems();
                },
                ensureItems() {
                    if (!Array.isArray(this.config.items))
                    {
                        this.config.items = [];
                    }

                    if (this.config.items.length > MAX_ITEMS)
                    {
                        this.config.items = this.config.items.slice(0, MAX_ITEMS);
                    }
                },
                addItem() {
                    this.ensureItems();

                    if (this.config.items.length >= MAX_ITEMS)
                    {
                        return;
                    }

                    this.config.items.push({
                        value: '',
                        label: '',
                        prefix: '',
                        suffix: ''
                    });
                },
                removeItem(index) {
                    if (!Array.isArray(this.config.items))
                    {
                        return;
                    }

                    this.config.items.splice(index, 1);
                },
                moveItem(fromIndex, toIndex) {
                    if (!Array.isArray(this.config.items))
                    {
                        return;
                    }

                    if (fromIndex < 0 || toIndex < 0)
                    {
                        return;
                    }

                    if (fromIndex >= this.config.items.length || toIndex >= this.config.items.length)
                    {
                        return;
                    }

                    if (fromIndex === toIndex)
                    {
                        return;
                    }

                    const next = [...this.config.items];
                    const [moved] = next.splice(fromIndex, 1);
                    next.splice(toIndex, 0, moved);
                    this.config.items = next;
                }
            };
      })()"
      @set="setConfig"
      @get="getConfig"
>
    <ul class="nav nav-tabs" role="tablist">
        <li class="nav-item"><a class="nav-link active" data-bs-toggle="tab" href="#stats-items" role="tab">Stats</a></li>
        <li class="nav-item"><a class="nav-link" data-bs-toggle="tab" href="#stats-layout" role="tab">Layout</a></li>
        <li class="nav-item"><a class="nav-link" data-bs-toggle="tab" href="#stats-show-hide" role="tab">Show/Hide</a></li>
        {{> common/dialogs/basic_nav }}
    </ul>

    <div class="tab-content">
        <div class="tab-pane show active" id="stats-items" role="tabpanel">
            <div class="mt-3">
                <div class="d-flex justify-content-between align-items-center gap-2 flex-wrap mb-3">
                    <div>
                        <label class="form-label mb-0">Stat metrics</label>
                        <p class="form-text text-muted mb-0 small">Add, remove, and reorder stat columns. Up to <span x-text="maxItems"></span> items.</p>
                    </div>
                    <button
                        type="button"
                        class="btn btn-primary btn-sm"
                        @click="addItem()"
                        :disabled="(config.items || []).length >= maxItems"
                    >
                        Add stat
                    </button>
                </div>

                <template x-if="!(config.items || []).length">
                    <div class="alert alert-warning mb-0" role="alert">
                        No stats configured yet.
                    </div>
                </template>

                <div class="d-flex flex-column gap-3" x-show="(config.items || []).length">
                    <template x-for="(item, itemIndex) in (config.items || [])" :key="itemIndex">
                        <div class="p-3 border rounded bg-body-secondary">
                            <div class="d-flex justify-content-between align-items-start gap-2 mb-3 flex-wrap">
                                <h6 class="mb-0" x-text="item.label || `Stat ${itemIndex + 1}`"></h6>
                                <div class="btn-group btn-group-sm">
                                    <button type="button" class="btn btn-outline-secondary" @click="moveItem(itemIndex, itemIndex - 1)" :disabled="itemIndex === 0" aria-label="Move stat up" title="Move stat up">▲</button>
                                    <button type="button" class="btn btn-outline-secondary" @click="moveItem(itemIndex, itemIndex + 1)" :disabled="itemIndex === (config.items.length - 1)" aria-label="Move stat down" title="Move stat down">▼</button>
                                    <button type="button" class="btn btn-outline-danger" @click="removeItem(itemIndex)" aria-label="Remove stat" title="Remove stat">✕</button>
                                </div>
                            </div>

                            <div class="row g-2 mb-2">
                                <div class="col-sm-4">
                                    <label class="form-label small mb-1">Prefix</label>
                                    <input type="text" class="form-control form-control-sm" x-model="item.prefix" placeholder="e.g. $">
                                </div>
                                <div class="col-sm-4">
                                    <label class="form-label small mb-1">Value</label>
                                    <input type="text" class="form-control form-control-sm" x-model="item.value" placeholder="e.g. 99.9">
                                </div>
                                <div class="col-sm-4">
                                    <label class="form-label small mb-1">Suffix</label>
                                    <input type="text" class="form-control form-control-sm" x-model="item.suffix" placeholder="e.g. % or K+">
                                </div>
                            </div>

                            <div class="mb-0">
                                <label class="form-label small mb-1">Label</label>
                                <input type="text" class="form-control form-control-sm" x-model="item.label" placeholder="Metric description">
                            </div>
                        </div>
                    </template>
                </div>
            </div>
        </div>

        <div class="tab-pane" id="stats-layout" role="tabpanel">
            <div class="p-3 bg-body-secondary border rounded mt-3">
                <div class="mb-3">
                    <label class="form-label">Column count</label>
                    <select class="form-select" x-model="config.columns">
                        <option value="two">Two columns</option>
                        <option value="three">Three columns</option>
                        <option value="four">Four columns</option>
                    </select>
                </div>
                <div class="form-check mb-3">
                    <input class="form-check-input" type="checkbox" x-model="config.centerTitle" id="statsCenterTitle">
                    <label class="form-check-label" for="statsCenterTitle">Center section title</label>
                </div>
                <div class="form-check mb-0">
                    <input class="form-check-input" type="checkbox" x-model="config.centerStats" id="statsCenterStats">
                    <label class="form-check-label" for="statsCenterStats">Center stat values and labels</label>
                </div>
            </div>
        </div>

        <div class="tab-pane" id="stats-show-hide" role="tabpanel">
            <div class="p-3 bg-body-secondary border rounded mt-3">
                <div class="mb-0">
                    <div class="form-check">
                        <input class="form-check-input" type="checkbox" x-model="config.hideTitle" id="statsHideTitle">
                        <label class="form-check-label" for="statsHideTitle">Hide section title</label>
                    </div>
                </div>
            </div>
        </div>

        {{> common/dialogs/basic_content hideAlternateBackground=false }}
    </div>
</form>
