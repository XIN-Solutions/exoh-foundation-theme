{{let . site=(ancestor-of-type 'site')}}
{{let . footer=site.content.expand.footer}}
{{let . siteName=site.content.forms.site.siteName}}
{{let . basicInfo=footer.basicInfo}}

<footer class="footer-1" data-exoh-scope="site">
  <div class="container">

    <div class="row">

      <div class="col-md">

        {{#if basicInfo.footerImage}}
          <div>
            {{let . footerImage=(image-url 
                basicInfo.footerImage 
                basicInfo.footerImage.file
                adjust=(array "height=50")  
              )
            }}
            <img src="{{footerImage}}" alt="Site logo" loading="lazy" class="logo-default mb-1" height="50">
            <img src="{{footerImage}}" alt="Site logo" loading="lazy" class="logo-default-dark mb-1" height="50">
          </div>
        {{/if}}

        {{#if basicInfo.footerTitle}}
          <p class="mb-0"><strong>{{basicInfo.footerTitle}}</strong></p>
        {{else}}
          {{#if basicInfo.slogan}}
            <p class="mb-0"><strong>{{siteName}}</strong></p>
          {{/if}}
        {{/if}}
        {{#if basicInfo.slogan}}
          <p><small class="text-muted">{{basicInfo.slogan}}</small></p>
        {{/if}}

        {{#if (or footer.contactInfo.address footer.contactInfo.phone footer.contactInfo.email)}}
          <div class="mt-2">
            {{#if footer.contactInfo.address}}
              <div class="footer-contact-address text-muted">{{footer.contactInfo.address}}</div>
            {{/if}}
            {{#if footer.contactInfo.phone}}
              <div>
                <a href="tel:{{footer.contactInfo.phone}}">
                  <i class="la la-phone" aria-hidden="true"></i>
                  <span>{{footer.contactInfo.phone}}</span>
                </a>
              </div>
            {{/if}}
            {{#if footer.contactInfo.email}}
              <div>
                <a href="mailto:{{footer.contactInfo.email}}">
                  <i class="la la-envelope" aria-hidden="true"></i>
                  <span>{{footer.contactInfo.email}}</span>
                </a>
              </div>
            {{/if}}
          </div>
        {{/if}}

        {{#if (or footer.socialMedia.facebook footer.socialMedia.twitter footer.socialMedia.instagram footer.socialMedia.linkedin)}}
          <div class="mt-2">
            {{#if footer.socialMedia.facebook}}
              <a href="{{footer.socialMedia.facebook}}" target="_blank" rel="noopener noreferrer" class="me-2">
                <i class="la la-facebook" aria-hidden="true"></i>
                <span class="visually-hidden">Facebook</span>
              </a>
            {{/if}}
            {{#if footer.socialMedia.twitter}}
              <a href="{{footer.socialMedia.twitter}}" target="_blank" rel="noopener noreferrer" class="me-2">
                <i class="la la-twitter" aria-hidden="true"></i>
                <span class="visually-hidden">Twitter</span>
              </a>
            {{/if}}
            {{#if footer.socialMedia.instagram}}
              <a href="{{footer.socialMedia.instagram}}" target="_blank" rel="noopener noreferrer" class="me-2">
                <i class="la la-instagram" aria-hidden="true"></i>
                <span class="visually-hidden">Instagram</span>
              </a>
            {{/if}}
            {{#if footer.socialMedia.linkedin}}
              <a href="{{footer.socialMedia.linkedin}}" target="_blank" rel="noopener noreferrer" class="me-2">
                <i class="la la-linkedin" aria-hidden="true"></i>
                <span class="visually-hidden">LinkedIn</span>
              </a>
            {{/if}}
          </div>
        {{/if}}

      </div>

      {{#if (has-items footer.firstColumn)}}
        <div class="col-md-2">
          {{#if footer.firstColumnTitle}}
            <div class="h6">{{footer.firstColumnTitle}}</div>
          {{/if}}
          <nav>
            {{#each footer.firstColumn as |link|}}
              {{let . url=(?: link.isExternal link.externalUrl link.pageUrl)}}
              <div>
                <a href="{{url}}">
                  <span>{{link.label}}</span>
                </a>
              </div>
            {{/each}}
          </nav>
        </div>
      {{/if}}

      {{#if (has-items footer.secondColumn)}}
        <div class="col-md-2">
          {{#if footer.secondColumnTitle}}
            <div class="h6">{{footer.secondColumnTitle}}</div>
          {{/if}}
          <nav>
            {{#each footer.secondColumn as |link|}}
              {{let . url=(?: link.isExternal link.externalUrl link.pageUrl)}}
              <div>
                <a href="{{url}}">
                  <span>{{link.label}}</span>
                </a>
              </div>
            {{/each}}
          </nav>
        </div>
      {{/if}}
    </div>

  </div>

  <div class="footer-copyright">
    <div class="container">
      <div class="d-flex flex-column flex-md-row">
        
        <div class="text-muted">
          {{footer.basicInfo.copyrightMessage}}
        </div>
      </div>
    </div>
  </div>

</footer>
